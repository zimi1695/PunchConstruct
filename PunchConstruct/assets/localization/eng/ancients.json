{
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.ancient": "...Spire's top... The Architect...",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.next": "Continue",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.char": "Opponent confirmed.",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.next": "Continue",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-2r.ancient": "...Let him... fall...",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.ancient": "...Down... again...",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.next": "Continue",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.char": "Next turn.",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.next": "Continue",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-2r.ancient": "...Next... turn...",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.ancient": "...Boxer... still... standing...?",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.next": "Continue",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.char": "(Slowly raises both fists.)",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.next": "Continue",
  "PUNCHCONSTRUCT_NEOW.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-2r.ancient": "...Good... go up...",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.ancient": "Whoa, those fists! Don't smash all my wares! Which one do you want? I'll find it for you!",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.next": "Continue",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.char": "(Slowly retracts an open palm.)",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.next": "Continue",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-2r.ancient": "Yes, yes, easy does it. See? You learn fast!",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.ancient": "That hole in your chest, I've got just the thing here, about the right size to plug it...",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.next": "Continue",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.char": "Retain.",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.next": "Continue",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-2r.ancient": "Fine! Everyone has junk they can't bear to throw out!",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.ancient": "That thing you took last time still working well? Wait. Don't tell me you've been hitting people with it too.",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.next": "Continue",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.char": "(Glances at its own fist.)",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.next": "Continue",
  "PUNCHCONSTRUCT_DARV.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-2r.ancient": "Fine, I think I know the answer already.",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.ancient": "Put your hands down, let me see... Mm, there are some spots on this metal worth decorating.",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.next": "Continue",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.char": "(Lowers its fists slightly.)",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.next": "Continue",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-2r.ancient": "Yes, just like that. You can't keep blocking my work forever.",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.ancient": "Such a shame about these scratches. Every time you get hurt, do you have to damage my handiwork a little too?",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.next": "Continue",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.char": "Will return.",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.next": "Continue",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-2r.ancient": "Then come back in one piece, as much as you can.",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.ancient": "Look, they're all watching you.",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.next": "Continue",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.char": "(Turns and takes a defensive stance.)",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.next": "Continue",
  "PUNCHCONSTRUCT_NONUPEIPE.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-2r.ancient": "...Sometimes... you just have to accept praise.",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.ancient": "You didn't bring a weapon! Left it in the Underdocks?!",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.next": "Continue",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.char": "(Raises the right fist, then the left.)",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.next": "Continue",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-2r.ancient": "Oh!! You brought two!!",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.ancient": "This one glows! That one glows too! Can your fists glow?!",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.next": "Continue",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.char": "(Two fists touch lightly, striking a few sparks.)",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.next": "Continue",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-2r.ancient": "I will!!",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.ancient": "A fist from the Underdocks! You got all the way up here?! Who brought you out?!",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.next": "Continue",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.char": "Walking.",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.next": "Continue",
  "PUNCHCONSTRUCT_OROBAS.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-2r.ancient": "I saw the legs! I asked about. Never mind, look at this!!",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.ancient": "The voice in your arm... never stopped.",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.next": "Continue",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.char": "(Loosens clenched fingers.)",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.next": "Continue",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-2r.ancient": "That's good. Rest a while... the next fight hasn't started yet.",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.ancient": "I dreamed you were standing on a very small floor. All around you... fallen things.",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.next": "Continue",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.char": "Already gone.",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.next": "Continue",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-2r.ancient": "Mm... I see it. You have come a long way.",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.ancient": "Even steel grows tired... Come, let a part of me bear it for you.",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.next": "Continue",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.char": "(Reaches toward that warm mass of flesh.)",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.next": "Continue",
  "PUNCHCONSTRUCT_PAEL.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-2r.ancient": "Take your time. You don't need to make a fist right now.",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.ancient": "Fists big enough!! Come on, hit me!!",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.next": "Continue",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.char": "(Deflects the incoming blow, then answers with a punch.)",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.next": "Continue",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-2r.ancient": "Hahaha!! That's what I'm talking about!!",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.ancient": "I have all these weapons, and all you really want is these fists?!",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.next": "Continue",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.char": "Already installed.",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.next": "Continue",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-2r.ancient": "Haha!! Then let's bolt some more junk onto them!!",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.ancient": "You're still blocking?! Hit me!!",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.next": "Continue",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.char": "Waiting.",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.next": "Continue",
  "PUNCHCONSTRUCT_TANX.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-2r.ancient": "What're you waiting. Oh!! Good punch!!",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.ancient": "Dear, your hands have gone stiff. Come over here and warm them.",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.next": "Continue",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.char": "(Holds out both dented hands.)",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.next": "Continue",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-2r.ancient": "My, what a pair of hard-working little hands.",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.ancient": "Sit down. I have soup, and a warm pair of gloves.",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.next": "Continue",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.char": "(Looks at the gloves, then at both fists.)",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.next": "Continue",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-2r.ancient": "Don't worry, dear. I'll make them fit.",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.ancient": "Always keeping your hands up in front of your face. Afraid I'll hit you?",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.next": "Continue",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.char": "(Slowly lowers both fists.)",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.next": "Continue",
  "PUNCHCONSTRUCT_TEZCATARA.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-2r.ancient": "That's it. Let me get a good look at what needs fixing.",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.ancient": "I can make your next punch never miss. All it takes is a small price from you.",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.next": "Continue",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.char": "(Does not lower the guarding hand.)",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.next": "Continue",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-2r.ancient": "What a pity. You look more cautious than the ones who actually bleed.",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.ancient": "No referee. No crowd. Who are you still winning for?",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.next": "Continue",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.char": "Self.",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.next": "Continue",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-2r.ancient": "Oh... that's a very easy excuse to exploit.",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.ancient": "You know that, don't you? You'll fall again. And you'll come back again.",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.next": "Continue",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.char": "Ready.",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.next": "Continue",
  "PUNCHCONSTRUCT_VAKUU.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-2r.ancient": "Then enjoy your match.",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.ancient": "A Punch Construct from the Underdocks? This is outside your operating range.",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-0r.next": "Continue",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.char": "Opponent confirmed.",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-1r.next": "Continue",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.0-2r.ancient": "It seems your recognition module needs to come out for inspection too.",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.ancient": "Scrap from the Underdocks. How did it get up here?",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-0r.next": "Continue",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.char": "(Plants its feet and raises both fists.)",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-1r.next": "Continue",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.1-2r.ancient": "Why are you still standing here?",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.ancient": "You again. Who exactly keeps replacing all those broken parts for you?",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-0r.next": "Continue",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.char": "Next turn.",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-1r.next": "Continue",
  "PUNCHCONSTRUCT_THE_ARCHITECT.talk.PUNCHCONSTRUCT-CONSTRUCT_CHARACTER.2-2r.ancient": "Then I'll take you apart more thoroughly."
}
